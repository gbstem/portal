<mjml>
  <mj-head>
    <mj-include path="../layout/head.mjml" />
  </mj-head>
  <mj-body background-color="#f8f8f8">
    <mj-include path="../layout/header.mjml" />
    <mj-section
      background-color="#ffffff"
      padding="20px 0px 20px 0px"
      padding-top="20px"
      padding-bottom="50px"
    >
      <mj-column>
        <mj-text color="#797e82" padding="0px 25px 5px 25px">
          <h1
            style="
              text-align: center;
              color: #000000;
              font-weight: 700;
              font-size: 34px;
            "
          >
            New Interview Timeslot Request From {{ interview.firstName }}
          </h1>
        </mj-text>
        <mj-text
          font-size="16px"
          line-height="22px"
          padding="10px 25px"
          padding-top="0px"
        >
          <p style="margin: 20px 0"></p>
          <p style="margin: 0 0">
            {{ interview.firstName }}, email {{ interview.email }}, is
            requesting a new interview timeslot at {{ interview.timeSlot }}. You
            can set the slot and assign them through the admin portal, which
            will notify them.
          </p>
        </mj-text>
        <mj-button
          href="https://admin.gbstem.org/dashboard"
          background-color="darkblue"
          color="#ffffff"
          font-size="14px"
          font-weight="normal"
          line-height="120%"
          border-radius="100px"
          inner-padding="15px 25px 15px 25px"
          padding="10px 25px"
          padding-top="20px"
          ><b style="font-weight: 700"
            ><b style="font-weight: 700">Access Portal </b></b
          ></mj-button
        >
      </mj-column>
    </mj-section>
    <mj-include path="../layout/footer.mjml" />
  </mj-body>
</mjml>
