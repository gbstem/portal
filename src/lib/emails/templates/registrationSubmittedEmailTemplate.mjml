<mjml>
  <mj-head>
    <mj-include path="../layout/head.mjml" />
  </mj-head>
  <mj-body background-color="#f8f8f8">
    <mj-include path="../layout/header.mjml" />
    <mj-section
      background-color="#ffffff"
      padding="20px 0px 20px 0px"
      padding-top="20px"
      padding-bottom="50px"
    >
      <mj-column>
        <mj-text color="#797e82" padding="0px 25px 5px 25px">
          <h1
            style="
              text-align: center;
              color: #000000;
              font-weight: 700;
              font-size: 34px;
            "
          >
            Registration Submitted
          </h1>
        </mj-text>
        <mj-text
          font-size="16px"
          line-height="22px"
          padding="10px 25px"
          padding-top="0px"
        >
          <p style="margin: 20px 0"></p>
          <p style="margin: 0 0">Hi {{ app.firstName }},</p>
          Thanks for registering {{ app.studentName }} for the semester! Please
          note that your registration does
          <span style="font-weight: 700">not</span> sign you up for a class for
          the semester, but it registers them to be on the enrollment list.
          Parent orientation will be on {{ app.parentOrientationDate }}; please
          keep an eye out for an email with details. At parent orientation you
          will learn how to enroll your child in their classes, so be sure to
          try to attend!
          <p></p>
          <p style="margin: 30px 0">
            In the meantime, follow us on
            <a
              href="https://instagram.com/gbstem"
              target="_blank"
              rel="noopener noreferrer"
              >Instagram</a
            >
            so you can stay up to date on all the exciting things happening with
            us!
          </p>
          <p style="margin: 30px 0">
            If you have any questions or concerns, visit our FAQs, or you can
            reach us at
            <a
              target="_blank"
              rel="noopener noreferrer"
              style="color: darkblue"
              href="mailto:contact@gbstem.org"
              >contact@gbstem.org</a
            >.
          </p>
          <p>With love 🤍,<br />The gbSTEM Team</p>
        </mj-text>
        <mj-button
          href="https://portal.gbstem.org/dashboard"
          background-color="darkblue"
          color="#ffffff"
          font-size="14px"
          font-weight="normal"
          line-height="120%"
          border-radius="100px"
          inner-padding="15px 25px 15px 25px"
          padding="10px 25px"
          padding-top="20px"
          ><b style="font-weight: 700"
            ><b style="font-weight: 700">Access Portal </b></b
          ></mj-button
        >
      </mj-column>
    </mj-section>
    <mj-include path="../layout/footer.mjml" />
  </mj-body>
</mjml>
